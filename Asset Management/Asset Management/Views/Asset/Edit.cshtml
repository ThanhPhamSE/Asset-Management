@model Asset_Management.ViewModels.AssetViewModel;

@{
    ViewData["Title"] = "Edit Asset";
}

<!DOCTYPE html>
<html lang="en">
<head>
    @* <title>Edit Asset</title> *@
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0, minimal-ui">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="../assets/fonts/tabler-icons.min.css">
    <link rel="stylesheet" href="../assets/fonts/feather.css">
    <link rel="stylesheet" href="../assets/fonts/fontawesome.css">
    <link rel="stylesheet" href="../assets/fonts/material.css">
    <link rel="stylesheet" href="../assets/css/style.css">
    <link rel="stylesheet" href="../assets/css/style-preset.css">
    <link href="~/assets/css/style.css" rel="stylesheet" />
    <link href="~/assets/fonts/tabler-icons.min.css" rel="stylesheet" />
    <link href="~/assets/fonts/feather.css" rel="stylesheet" />
    <link href="~/assets/fonts/fontawesome.css" rel="stylesheet" />
    <link href="~/assets/fonts/material.css" rel="stylesheet" />
    <link href="~/assets/css/style-preset.css" rel="stylesheet" />
</head>
<body>
    <partial name="_NavbarPartial" />

    <div class="pc-container">
        <div class="pc-content">
            <div class="page-header">
                <div class="page-block">
                    <div class="row align-items-center">
                        <div class="col-md-12">
                            <ul class="breadcrumb">
                                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Dashboard">Home</a></li>
                                <li class="breadcrumb-item"><a asp-action="List" asp-controller="Asset">Assets</a></li>
                                <li class="breadcrumb-item" aria-current="page">Edit Asset</li>
                            </ul>
                        </div>
                        <div class="col-md-12">
                            <div class="page-header-title">
                                <h2 class="mb-0">Add Asset</h2>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- [ Main Content ] start -->
            <form asp-action="Edit" asp-controller="Asset" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="AssetId" />

                <div class="row">
                    <div class="col-sm-12">
                        <div class="card">
                            <div class="card-body">
                                <div class="row">
                                    <!-- Cột trái -->
                                    <div class="col-md-6">
                                        <div class="card">
                                            <div class="card-body">
                                                <div class="form-group">
                                                    <label class="form-label">Asset Code</label>
                                                    <input type="text" asp-for="AssetCode" class="form-control" placeholder="Enter Asset Code">
                                                    <span asp-validation-for="AssetCode" class="text-danger"></span>
                                                </div>
                                                <div class="form-group">
                                                    <label class="form-label">Asset Name</label>
                                                    <input type="text" asp-for="AssetName" class="form-control" placeholder="Enter Asset Name">
                                                    <span asp-validation-for="AssetName" class="text-danger"></span>
                                                </div>
                                                <div class="form-group">
                                                    <label class="form-label">Category</label>
                                                    <select asp-for="CategoryId" class="form-select" asp-items="@(new SelectList(ViewBag.Categories, "CategoryId", "CategoryName", Model.CategoryId))"></select>
                                                </div>
                                                <div class="form-group">
                                                    <label class="form-label">Purchase Date</label>
                                                    <input type="date" asp-for="PurchaseDate" class="form-control">
                                                    <span asp-validation-for="PurchaseDate" class="text-danger"></span>
                                                </div>
                                                <div class="form-group">
                                                    <label class="form-label">Purchase Price ($)</label>
                                                    <input type="number" step="0.01" asp-for="PurchasePrice" class="form-control" placeholder="Enter Purchase Price">
                                                    <span asp-validation-for="PurchasePrice" class="text-danger"></span>
                                                </div>
                                                <div class="form-group">
                                                    <label class="form-label">Current Value ($)</label>
                                                    <input type="number" step="0.01" asp-for="CurrentValue" class="form-control" placeholder="Enter Current Value">
                                                    <span asp-validation-for="CurrentValue" class="text-danger"></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Cột phải -->
                                    <div class="col-md-6">
                                        <div class="card">
                                            <div class="card-body">
                                                <div class="form-group">
                                                    <label class="form-label">Depreciation Rate (%)</label>
                                                    <input type="number" asp-for="DepreciationRate" class="form-control" placeholder="Enter Depreciation Rate">
                                                    <span asp-validation-for="DepreciationRate" class="text-danger"></span>
                                                </div>
                                                <div class="form-group">
                                                    <label class="form-label">Status</label>
                                                    <select asp-for="StatusId" class="form-select" asp-items="@(new SelectList(ViewBag.Statuses, "StatusId", "StatusName", Model.StatusId))"></select>
                                                </div>
                                                <div class="form-group">
                                                    <label class="form-label">Location</label>
                                                    <select asp-for="LocationId" class="form-select" asp-items="@(new SelectList(ViewBag.Locations, "LocationId", "LocationName", Model.LocationId))"></select>
                                                </div>
                                                <div class="form-group">
                                                    <p><span class="text-danger">*</span> Recommended resolution is 640x640</p>
                                                    <label class="btn btn-outline-secondary" for="flupld"><i class="ti ti-upload me-2"></i> Upload Image</label>
                                                    <input type="file" asp-for="ImageFile" id="flupld" class="form-control">
                                                    <span asp-validation-for="ImageFile" class="text-danger"></span>
                                                </div>

                                                <!-- Hiển thị ảnh hiện tại -->
                                                @if (!string.IsNullOrEmpty(Model.ImagePath))
                                                {
                                                    <div class="form-group mt-3">
                                                        <label class="form-label">Current Image</label>
                                                        <br />
                                                        <img src="@Model.ImagePath" alt="Asset Image" class="img-thumbnail" width="200" />
                                                    </div>
                                                }

                                                <div class="text-end btn-page mb-0 mt-4">
                                                    <button type="reset" class="btn btn-outline-secondary">Cancel</button>
                                                    <button type="submit" class="btn btn-primary">Update Asset</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
            <!-- [ Main Content ] end -->
        </div>
    </div>

    <!-- [ Scripts ] -->
    <script src="../assets/js/plugins/popper.min.js"></script>
    <script src="../assets/js/plugins/bootstrap.min.js"></script>
    <script src="../assets/js/plugins/feather.min.js"></script>
    <script src="../assets/js/pcoded.js"></script>
    <script>layout_change('light');</script>
</body>
</html>