@model IEnumerable<Asset_Management.ViewModels.AssetViewModel>;

@{
    ViewData["Title"] = "Asset Management";
}


<!DOCTYPE html>
<html lang="en">
<!-- [Head] start -->

<head>
    <title>Asset Management</title>
    <!-- [Meta] -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0, minimal-ui">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="description" content="Mantis is made using Bootstrap 5 design framework. Download the free admin template & use it for your project.">
    <meta name="keywords" content="Mantis, Dashboard UI Kit, Bootstrap 5, Admin Template, Admin Dashboard, CRM, CMS, Bootstrap Admin Template">
    <meta name="author" content="CodedThemes">

    <!-- [Favicon] icon -->
    <link rel="icon" href="../assets/images/favicon.svg" type="image/x-icon"> <!-- [Google Font] Family -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700&display=swap" id="main-font-link">
    <!-- [Tabler Icons] https://tablericons.com -->
    <link rel="stylesheet" href="../assets/fonts/tabler-icons.min.css">
    <!-- [Feather Icons] https://feathericons.com -->
    <link rel="stylesheet" href="../assets/fonts/feather.css">
    <!-- [Font Awesome Icons] https://fontawesome.com/icons -->
    <link rel="stylesheet" href="../assets/fonts/fontawesome.css">
    <!-- [Material Icons] https://fonts.google.com/icons -->
    <link rel="stylesheet" href="../assets/fonts/material.css">
    <!-- [Template CSS Files] -->
    <link rel="stylesheet" href="../assets/css/style.css" id="main-style-link">
    <link rel="stylesheet" href="../assets/css/style-preset.css">

</head>
<!-- [Head] end -->
<!-- [Body] Start -->

<body>



    <partial name="_NavbarPartial" />




    <!-- [ Main Content ] start -->
    <div class="pc-container">
        <div class="pc-content">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="text-end p-4 pb-0">
                <a asp-controller="Asset" asp-action="CreateAsset" class="btn btn-primary">
                    <i class="ti ti-plus f-18"></i> Add Asset
                </a>
                @* <a href="@Url.Action("ExportToExcel", new { categoryId = ViewBag.SelectedCategory, statusId = ViewBag.SelectedStatus, locationId = ViewBag.SelectedLocation, searchTerm = ViewBag.SearchTerm })" class="btn btn-success">Xuất Excel</a> *@
                <a href="@Url.Action("ExportToExcel", "Asset", new {
                categoryId = Context.Request.Query["categoryId"],
                statusId = Context.Request.Query["statusId"],
                locationId = Context.Request.Query["locationId"],
                searchTerm = Context.Request.Query["searchTerm"]
            })" class="btn btn-success">Xuất Excel</a>
            </div>
            <form method="get" action="@Url.Action("List")">
                <div class="row px-4 pb-3">
                    <!-- Search -->
                    <div class="col-md-3">
                        <label for="searchTerm" class="form-label">Search Asset:</label>
                        <input type="text" id="searchTerm" name="searchTerm" class="form-control" placeholder="Enter asset name..."
                               value="@Context.Request.Query["searchTerm"]" onkeypress="if(event.keyCode==13) this.form.submit();">
                    </div>

                    <!-- Filter by Status -->
                    <div class="col-md-3">
                        <label for="filterStatus" class="form-label">Filter by Status:</label>
                        <select id="filterStatus" name="statusId" class="form-select" onchange="this.form.submit()">
                            <option value="">All</option>
                            @foreach (var status in ViewBag.Statuses)
                            {
                                <option value="@status.StatusId" selected="@(Context.Request.Query["statusId"] == status.StatusId.ToString() ? "selected" : null)">
                                    @status.StatusName
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Filter by Location -->
                    <div class="col-md-3">
                        <label for="filterLocation" class="form-label">Filter by Location:</label>
                        <select id="filterLocation" name="locationId" class="form-select" onchange="this.form.submit()">
                            <option value="">All</option>
                            @foreach (var location in ViewBag.Locations)
                            {
                                <option value="@location.LocationId" selected="@(Context.Request.Query["locationId"] == location.LocationId.ToString() ? "selected" : null)">
                                    @location.LocationName
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label for="filterCategory" class="form-label">Filter by Category:</label>
                        <select id="filterCategory" name="categoryId" class="form-select" onchange="this.form.submit()">
                            <option value="" selected="@(string.IsNullOrEmpty(Context.Request.Query["categoryId"]) ? "selected" : null)">All</option>
                            @foreach (var category in ViewBag.Categories)
                            {
                                var isSelected = Context.Request.Query["categoryId"] == category.CategoryId.ToString() ? "selected" : null;
                                <option value="@category.CategoryId" selected="@isSelected">@category.CategoryName</option>
                            }
                        </select>
                    </div>
                </div>
            </form>

            <!-- Asset Table -->
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Asset</th>
                            <th>Categories</th>
                            <th>Purchase Date</th>
                            <th>Purchase Price</th>
                            <th>Current Value</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var asset in Model)
                        {
                            <tr>
                                <td>@asset.AssetId</td>
                                <td>@asset.AssetName</td>
                                <td>@asset.CategoryName</td>
                                <td>@asset.PurchaseDate.ToShortDateString()</td>
                                <td>@(asset.PurchasePrice.ToString("C"))</td>
                                <td>@(asset.CurrentValue.HasValue ? asset.CurrentValue.Value.ToString("C") : "N/A")</td>
                                <td>@asset.LocationName</td>
                                <td><span class="badge bg-light-success f-12">@asset.StatusName</span></td>
                                <td class="text-center">
                                    <a asp-controller="Asset" asp-action="Edit" asp-route-id="@asset.AssetId" class="btn btn-sm btn-primary">Edit</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <form asp-action="ImportFromExcel" asp-controller="Asset" method="post" enctype="multipart/form-data">
                <div class="form-group">
                    <label for="file">Chọn file Excel:</label>
                    <input type="file" name="file" class="form-control" required />
                </div>
                <button type="submit" class="btn btn-primary">Nhập từ Excel</button>
            </form>
            <!-- Pagination -->
            @if (ViewBag.TotalPages > 1)
            {
                <nav>
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                                <a class="page-link" href="?searchTerm=@ViewBag.SearchTerm&statusId=@ViewBag.SelectedStatus&locationId=@ViewBag.SelectedLocation&page=@i">
                                    @i
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            }

                <!-- [ sample-page ] end -->
            </div>
            <!-- [ Main Content ] end -->
        </div>
    </div>
    <!-- [ Main Content ] end -->
    <!-- Required Js -->
    <script src="../assets/js/plugins/popper.min.js"></script>
    <script src="../assets/js/plugins/simplebar.min.js"></script>
    <script src="../assets/js/plugins/bootstrap.min.js"></script>
    <script src="../assets/js/fonts/custom-font.js"></script>
    <script src="../assets/js/pcoded.js"></script>
    <script src="../assets/js/plugins/feather.min.js"></script>





    <script>layout_change('light');</script>




    <script>change_box_container('false');</script>



    <script>layout_rtl_change('false');</script>


    <script>preset_change("preset-1");</script>


    <script>font_change("Public-Sans");</script>

</body>
<!-- [Body] end -->

</html>