              <div class="table-responsive">
                <table class="table table-hover" id="pc-dt-simple">
                  <thead>
                    <tr>
                      <th></th>
                      <th>#</th>
                      <th>User Name</th>
                      <th>FullName</th>
                      <th>Email</th>
                      <th>Role</th>
                      <th>Status</th>
                      <th class="text-center">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    @foreach (var user in Model){
                        <tr>
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox">
                                </div>
                            </td>
                            <td>@user.Id</td>
                            <td>
                                <div class="row">
                                    <div class="col-auto pe-0">
                                        <img src="../assets/images/user/avatar-1.jpg" alt="user-image"
                                                class="wid-40 rounded-circle">
                                    </div>
                                    <div class="col">
                                        <h5 class="mb-0">@user.UserName</h5>
                                        <p class="text-muted f-12 mb-0">@user.Email</p>
                                    </div>
                                </div>
                            </td>
                            <td>@user.FullName</td>
                            <td>@user.Email</td>
                            <td>@user.Role</td>
                            @* @if (user.IsActive)
                            {
                                <a asp-action="ToggleStatus" asp-route-id="@user.Id"><td><span class="badge bg-light-success rounded-pill f-12">Active</span></td></a>
                            }
                            else
                            {
                                <a asp-action="ToggleStatus" asp-route-id="@user.Id"><td><span class="badge bg-light-success rounded-pill f-12">InActive</span></td></a>
                            } *@
                            <td>
                                <a asp-action="ToggleStatus" asp-route-id="@user.Id" class="btn">
                                    <span class="badge @(user.IsActive ? "bg-light-success" : "bg-light-danger") rounded-pill f-12">
                                        @(user.IsActive ? "Active" : "Inactive")
                                    </span>
                                </a>
                            </td>

                            <td class="text-center">
                                <ul class="list-inline me-auto mb-0">
                                    <li class="list-inline-item align-bottom" data-bs-toggle="tooltip" title="View">
                                        <a href="#" class="avtar avtar-xs btn-link-secondary" data-bs-toggle="modal"
                                            data-bs-target="#user-modal">
                                            <i class="ti ti-eye f-18"></i>
                                        </a>
                                    </li>
                                    <li class="list-inline-item align-bottom" data-bs-toggle="tooltip" title="Edit">
                                        <a href="#" class="avtar avtar-xs btn-link-primary edit-user-btn"
                                            data-bs-toggle="modal"
                                            data-bs-target="#user-edit_add-modal"
                                            data-id="@user.Id"
                                            data-username="@user.UserName"
                                            data-fullname="@user.FullName"
                                            data-email="@user.Email"
                                            data-role="@(user.Role ?? "")">
                                            <i class="ti ti-edit-circle f-18"></i>
                                        </a>
                                    </li>


                                    <li class="list-inline-item align-bottom" data-bs-toggle="tooltip" title="Delete">
                                        <a asp-action="Delete" asp-controller="User" asp-route-userId="@user.Id"
                                            class="avtar avtar-xs btn-link-danger"
                                            onclick="return confirm('Are you sure you want to delete this user?');">
                                            <i class="ti ti-trash f-18"></i>
                                        </a>
                                    </li>

                                </ul>
                            </td>
                        </tr>
                    }
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
