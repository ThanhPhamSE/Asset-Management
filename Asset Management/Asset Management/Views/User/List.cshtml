    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Tạo ánh xạ RoleName -> RoleId từ ViewBag.Roles
            let roleMap = {};
        @if (ViewBag.Roles != null)
        {
            foreach (var role in ViewBag.Roles)
            {
                @:roleMap["@role.Name"] = "@role.Id";
            }
        }

                document.querySelectorAll(".edit-user-btn").forEach(button => {
                    button.addEventListener("click", function () {
                        console.log("Clicked button:", this);  // Debug xem nút được nhấn

                        let userId = this.dataset.id;
                        let userName = this.dataset.username;
                        let fullName = this.dataset.fullname;
                        let email = this.dataset.email;
                        let roleName = this.dataset.role; // Lấy tên role thay vì ID

                        console.log("UserId:", userId);
                        console.log("UserName:", userName);
                        console.log("Role Name:", roleName);

                        // Tìm RoleId dựa trên tên Role
                        let roleId = roleMap[roleName] || "";

                        console.log("Mapped RoleId:", roleId); // Debug giá trị RoleId sau khi ánh xạ

                        // Gán dữ liệu vào modal
                        document.querySelector("#user-edit_add-modal input[name='Id']").value = userId;
                        document.querySelector("#user-edit_add-modal input[name='UserName']").value = userName;
                        document.querySelector("#user-edit_add-modal input[name='FullName']").value = fullName;
                        document.querySelector("#user-edit_add-modal input[name='Email']").value = email;

                        // Binding Role vào dropdown
                        let roleDropdown = document.querySelector("#user-edit_add-modal select[name='RoleId']");
                        if (roleDropdown) {
                            roleDropdown.value = roleId;
                            console.log("Dropdown RoleId set to:", roleDropdown.value);
                        } else {
                            console.error("Dropdown RoleId not found!");
                        }
                    });
                });
        });

    </script>


    

