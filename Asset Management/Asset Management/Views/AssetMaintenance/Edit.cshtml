@model Asset_Management.ViewModels.AssetMaintenanceViewModel

@{
    ViewData["Title"] = "Edit Asset Maintenance";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0, minimal-ui">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <link rel="stylesheet" href="~/assets/css/style.css" />
    <link rel="stylesheet" href="~/assets/css/style-preset.css" />
</head>
<body>
    <partial name="_NavbarPartial" />

    <div class="pc-container">
        <div class="pc-content">
            <div class="page-header">
                <div class="page-block">
                    <div class="row align-items-center">
                        <div class="col-md-12">
                            <ul class="breadcrumb">
                                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Dashboard">Home</a></li>
                                <li class="breadcrumb-item"><a asp-action="List" asp-controller="Asset">Assets</a></li>
                                <li class="breadcrumb-item" aria-current="page">Edit Asset Maintenance</li>
                            </ul>
                        </div>
                        @if (TempData["ErrorAddMaintenanceMessage"] != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                @TempData["ErrorAddMaintenanceMessage"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }
                        <div class="col-md-12">
                            <div class="page-header-title">
                                <h2 class="mb-0">Edit Asset Maintenance</h2>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MaintenanceId" />
                <div class="row">
                    <div class="col-sm-12">
                        <div class="card">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="card">
                                            <div class="card-body">
                                                <div class="form-group">
                                                    <label class="form-label">Asset</label>
                                                    <select asp-for="AssetId" class="form-control">
                                                        @foreach (var asset in ViewBag.Assets)
                                                        {
                                                            <option value="@asset.AssetId" selected="@(asset.AssetId == Model.AssetId)">@asset.AssetName</option>
                                                        }
                                                    </select>
                                                </div>
                                                @* <div class="form-group">
                                                    <label class="form-label">Maintenance Date</label>
                                                    <input type="date" asp-for="MaintenanceDate" class="form-control">
                                                    <span asp-validation-for="MaintenanceDate" class="text-danger"></span>
                                                </div> *@
                                                <div class="form-group">
                                                    <label class="form-label">Maintenance Date</label>
                                                    <input type="date" asp-for="MaintenanceDate" class="form-control"
                                                           value="@DateTime.Now.ToString("yyyy-MM-dd")"
                                                           max="@DateTime.Now.ToString("yyyy-MM-dd")"
                                                           placeholder="Enter Maintenance Date" />
                                                    <span asp-validation-for="MaintenanceDate" class="text-danger"></span>
                                                </div>
                                                <div class="form-group">
                                                    <label class="form-label">Maintenance Type</label>
                                                    <input type="text" asp-for="MaintenanceType" class="form-control">
                                                    <span asp-validation-for="MaintenanceType" class="text-danger"></span>
                                                </div>
                                                <div class="form-group">
                                                    <label class="form-label">Maintenance Cost</label>
                                                    <input type="text" asp-for="MaintenanceCost" class="form-control">
                                                    <span asp-validation-for="MaintenanceCost" class="text-danger"></span>
                                                </div>
                                                <div class="form-group">
                                                    <label class="form-label">Notes</label>
                                                    <textarea asp-for="Notes" class="form-control"></textarea>
                                                    <span asp-validation-for="Notes" class="text-danger"></span>
                                                </div>
                                                <div class="form-group">
                                                    <label class="form-label">Status</label>
                                                    <select asp-for="StatusId" class="form-control">
                                                        @foreach (var status in ViewBag.Statuses)
                                                        {
                                                            <option value="@status.StatusId" selected="@(status.StatusId == Model.StatusId)">@status.StatusName</option>
                                                        }
                                                    </select>
                                                    <span asp-validation-for="StatusId" class="text-danger"></span>
                                                </div>
                                                <div class="text-end btn-page mb-0 mt-4">
                                                    <a asp-action="List" asp-controller="Asset" class="btn btn-outline-secondary">Cancel</a>
                                                    <button type="submit" class="btn btn-primary">Save Changes</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <script src="~/assets/js/plugins/popper.min.js"></script>
    <script src="~/assets/js/plugins/bootstrap.min.js"></script>
    <script src="~/assets/js/plugins/feather.min.js"></script>
    <script src="~/assets/js/pcoded.js"></script>
    <script>layout_change('light');</script>
</body>
</html>
