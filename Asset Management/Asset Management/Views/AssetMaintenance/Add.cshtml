@model Asset_Management.ViewModels.AssetMaintenanceViewModel

@{
    ViewData["Title"] = "Add Asset Maintenance";
}

<!DOCTYPE html>
<html lang="en">
<head>
    @* <title>Edit Asset</title> *@
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0, minimal-ui">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="../assets/fonts/tabler-icons.min.css">
    <link rel="stylesheet" href="../assets/fonts/feather.css">
    <link rel="stylesheet" href="../assets/fonts/fontawesome.css">
    <link rel="stylesheet" href="../assets/fonts/material.css">
    <link rel="stylesheet" href="../assets/css/style.css">
    <link rel="stylesheet" href="../assets/css/style-preset.css">
    <link href="~/assets/css/style.css" rel="stylesheet" />
    <link href="~/assets/fonts/tabler-icons.min.css" rel="stylesheet" />
    <link href="~/assets/fonts/feather.css" rel="stylesheet" />
    <link href="~/assets/fonts/fontawesome.css" rel="stylesheet" />
    <link href="~/assets/fonts/material.css" rel="stylesheet" />
    <link href="~/assets/css/style-preset.css" rel="stylesheet" />
</head>
<body>
    <partial name="_NavbarPartial" />

    <div class="pc-container">
        <div class="pc-content">
            <div class="page-header">
                <div class="page-block">
                    <div class="row align-items-center">
                        <div class="col-md-12">
                            <ul class="breadcrumb">
                                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Dashboard">Home</a></li>
                                <li class="breadcrumb-item"><a asp-action="List" asp-controller="Asset">Assets</a></li>
                                <li class="breadcrumb-item" aria-current="page">Add Asset</li>
                            </ul>
                        </div>
                        @if (TempData["ErrorAddMaintenanceMessage"] != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                @TempData["ErrorAddMaintenanceMessage"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }
                        <div class="col-md-12">
                            <div class="page-header-title">
                                <h2 class="mb-0">Add Asset</h2>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- [ Main Content ] start -->
            <form asp-action="Add" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="row">
                    <div class="col-sm-12">
                        <div class="card">
                            <div class="card-body">
                                <div class="row">
                                    <!-- Cột trái -->
                                    <div class="col-md-12">
                                        <div class="card">
                                            <div class="card-body">
                                                <div class="form-group">
                                                    <label class="form-label">Asset</label>
                                                    <div class="form-group">
                                                        <label for="AssetId">Chọn Tài Sản</label>
                                                        <select asp-for="AssetId" class="form-control">
                                                            @foreach (var asset in ViewBag.Assets)
                                                            {
                                                                <option value="@asset.AssetId">@asset.AssetName</option>
                                                            }
                                                        </select>
                                                    </div>
                                                </div>
                                                @* <div class="form-group">
                                                    <label class="form-label">Maintenance Date</label>
                                                    <input type="date" asp-for="MaintenanceDate" class="form-control" placeholder="Enter Maintenance Date">
                                                    <span asp-validation-for="MaintenanceDate" class="text-danger"></span>
                                                </div> *@
                                                <div class="form-group">
                                                    <label class="form-label">Maintenance Date</label>
                                                    <input type="date" asp-for="MaintenanceDate" class="form-control"
                                                           value="@DateTime.Now.ToString("yyyy-MM-dd")"
                                                           max="@DateTime.Now.ToString("yyyy-MM-dd")"
                                                           placeholder="Enter Maintenance Date" />
                                                    <span asp-validation-for="MaintenanceDate" class="text-danger"></span>
                                                </div>
                                                <div class="form-group">
                                                    <label class="form-label">Maintenance Type</label>
                                                    <input type="text" asp-for="MaintenanceType" class="form-control" placeholder="Enter Maintenance Type">
                                                    <span asp-validation-for="MaintenanceType" class="text-danger"></span>
                                                </div>
                                                <div class="form-group">
                                                    <label class="form-label">Maintenance Cost</label>
                                                    <input type="text" asp-for="MaintenanceCost" class="form-control" placeholder="Enter Maintenance Cost">
                                                    <span asp-validation-for="MaintenanceCost" class="text-danger"></span>
                                                </div>
                                                <div class="form-group">
                                                    <label class="form-label">Notes</label>
                                                    <input type="textarea" asp-for="Notes" class="form-control" placeholder="Enter Notes">
                                                    <span asp-validation-for="Notes" class="text-danger"></span>
                                                </div>
                                                <div class="text-end btn-page mb-0 mt-4">
                                                    <button type="reset" class="btn btn-outline-secondary">Cancel</button>
                                                    <button type="submit" class="btn btn-primary">Add Asset Maintenance</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
            <!-- [ Main Content ] end -->
        </div>
    </div>

    <!-- [ Scripts ] -->
    <script src="../assets/js/plugins/popper.min.js"></script>
    <script src="../assets/js/plugins/bootstrap.min.js"></script>
    <script src="../assets/js/plugins/feather.min.js"></script>
    <script src="../assets/js/pcoded.js"></script>
    <script>layout_change('light');</script>
</body>
</html>
